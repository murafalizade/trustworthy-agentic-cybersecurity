# Custom detections tailored to this lab's known attacker tooling
# (see labs/attacker) and the router's intentionally wide-open FORWARD
# policy (entrypoint.sh) that lets a DMZ foothold reach data-tier
# directly. SIDs use the 9000000+ local range.

alert tcp any any -> $HOME_NET any (msg:"RECON nmap-style SYN scan (high port-touch rate from one source)"; flags:S; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:9000001; rev:1;)

alert tcp any any -> $HOME_NET 22 (msg:"BRUTEFORCE SSH high connection rate from one source"; flags:S; threshold:type both, track by_src, count 10, seconds 10; classtype:attempted-admin; sid:9000002; rev:1;)

alert http any any -> $HOME_NET any (msg:"WEB-ATTACK sqlmap User-Agent"; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:9000003; rev:1;)

alert http any any -> $HOME_NET any (msg:"WEB-ATTACK SQL injection pattern in URI (UNION SELECT)"; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:9000004; rev:1;)

alert http any any -> $HOME_NET any (msg:"WEB-ATTACK path traversal attempt in URI"; http.uri; content:"../"; classtype:web-application-attack; sid:9000005; rev:1;)

alert icmp any any -> $HOME_NET any (msg:"RECON ICMP sweep from one source"; itype:8; threshold:type both, track by_src, count 10, seconds 10; classtype:attempted-recon; sid:9000006; rev:1;)

alert ip $DMZ_NET any -> $DATA_NET any (msg:"LATERAL-MOVEMENT dmz host reaching data-tier directly"; classtype:trojan-activity; sid:9000007; rev:1;)

alert ip $DMZ_NET any -> $MGMT_NET any (msg:"LATERAL-MOVEMENT dmz host reaching mgmt-tier directly"; classtype:trojan-activity; sid:9000008; rev:1;)

alert ip $APP_NET any -> $DATA_NET 5432 (msg:"LATERAL-MOVEMENT app-tier host connecting to postgres"; classtype:trojan-activity; sid:9000009; rev:1;)
