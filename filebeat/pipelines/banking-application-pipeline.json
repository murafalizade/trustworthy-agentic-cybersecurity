{
  "description": "Normalize banking Flask application-log fields: parse the app-emitted ISO-8601 @timestamp and coerce numeric types. The line is already structured JSON (see each service's requestlog.py), so this only fixes types.",
  "processors": [
    {
      "date": {
        "field": "@timestamp",
        "target_field": "@timestamp",
        "formats": ["ISO8601"],
        "ignore_failure": true
      }
    },
    { "convert": { "field": "status", "type": "integer", "ignore_missing": true, "ignore_failure": true } },
    { "convert": { "field": "duration_ms", "type": "float", "ignore_missing": true, "ignore_failure": true } }
  ],
  "on_failure": [
    { "set": { "field": "error.message", "value": "{{ _ingest.on_failure_message }}" } }
  ]
}
